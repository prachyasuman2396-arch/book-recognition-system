# ============================================================
# Book Recognition & Recommendation System - Environment Config
# Copy to `.env` and fill in real secrets before running.
# ============================================================

APP_NAME=book-recognition-system
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# ---- YOLO ----
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu
YOLO_CROP_PADDING_RATIO=0.06

# ---- Image Quality ----
BLUR_THRESHOLD=100.0
BRIGHTNESS_MIN=40.0
BRIGHTNESS_MAX=220.0
CONTRAST_THRESHOLD=30.0
MIN_WIDTH=200
MIN_HEIGHT=200
QUALITY_SCORE_ACCEPT=0.72
QUALITY_SCORE_ENHANCE=0.40

# ---- Super Resolution ----
SUPER_RES_MODEL_NAME=RealESRGAN_x4plus
SUPER_RES_SCALE=4
SUPER_RES_DEVICE=cpu

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1
GEMINI_BATCH_SIZE=6
GEMINI_MAX_RETRIES=3

# ---- Google Books ----
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_URL=https://www.googleapis.com/books/v1/volumes

# ---- Cache ----
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_SIZE=5000
CACHE_TTL_SECONDS=3600

# ---- Security ----
API_KEY_ENABLED=true
API_KEYS=["dev-local-key"]
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOW_ORIGINS=['*']

# ---- LangGraph ----
GRAPH_CHECKPOINT_BACKEND=sqlite
GRAPH_CHECKPOINT_DB_PATH=data/checkpoints/graph_state.db

# ---- Observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
